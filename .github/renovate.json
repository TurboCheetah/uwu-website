{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    ":enableVulnerabilityAlerts"
  ],
  "labels": ["Meta: Dependencies"],
  "schedule": ["before 12pm on Sunday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\/)package\\.json$/"],
      "matchStrings": ["\"packageManager\"\\s*:\\s*\"bun@(?<currentValue>[^\"\\s]+)\""],
      "depNameTemplate": "bun",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "groupName": "Bun",
      "matchPackageNames": ["bun", "@types/bun"]
    },
    {
      "groupName": "Next.js and React",
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"]
    },
    {
      "groupName": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/postcss"]
    },
    {
      "groupName": "Oxc tooling",
      "matchPackageNames": ["oxfmt", "oxlint"]
    },
    {
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchJsonata": ["$exists(vulnerabilityFixVersion)"],
      "automerge": false
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "vulnerabilityFixStrategy": "lowest"
  }
}
