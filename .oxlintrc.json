{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs"],
  "env": {
    "browser": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
