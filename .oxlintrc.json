{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".hermes/**", "dist/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "node": true
  }
}
